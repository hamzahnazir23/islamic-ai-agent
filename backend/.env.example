# Copy to .env and fill in. Never commit the filled-in file.

# ---- Required ----

# OpenAI key used for both query embeddings and answer generation.
OPENAI_API_KEY=sk-...

# Postgres with the pgvector extension. Takes precedence over the PG*
# vars below; Railway and most managed providers supply this directly.
DATABASE_URL=postgresql://user:password@host:5432/islamic_ai

# ---- Local development ----
# Used only when DATABASE_URL is unset.
PGDATABASE=islamic_ai
PGUSER=your_local_user
PGPASSWORD=
PGHOST=localhost
PGPORT=5432

# ---- Retrieval tuning ----

# Minimum cosine similarity (0-1) for a result to be cited. Lower =
# more sources but weaker relevance. Below ~0.25 the model starts
# citing loosely-related verses with full confidence.
MIN_SIMILARITY=0.30

# ---- Sessions ----

# How long a login lasts. Sessions are server-side rows; logging out
# deletes the row, so revocation is immediate.
SESSION_TTL_DAYS=30

# Cookie flags. Defaults suit local development over http.
#   COOKIE_SECURE=true   required in production (https only)
#   COOKIE_SAMESITE=none required when the frontend is on a DIFFERENT
#                        site than the API; browsers reject SameSite=None
#                        unless Secure is also true.
# localhost:3000 -> localhost:8000 is same-site, so "lax" works locally.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# ---- API protection ----

# Comma-separated browser origins allowed to call /ask. This must be the
# FRONTEND origin, not the API's own URL. Getting it wrong breaks the
# deployed app with a CORS error.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.up.railway.app

# Per-IP request caps.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# Failed logins allowed per 15 minutes, keyed by IP + email.
LOGIN_RATE_LIMIT=5

# Honour X-Forwarded-For when resolving the client IP. Set true ONLY
# behind a proxy you control that overwrites the header (Railway does).
# True without such a proxy lets anyone bypass the rate limit by
# spoofing the header; false behind one makes every user share a single
# IP budget.
TRUST_PROXY=false

# ---- Connection pool ----
DB_POOL_MAX=10
