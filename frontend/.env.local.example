# Copy to .env.local for local development.
#
# Must be http://localhost:8000 rather than 127.0.0.1:8000. The session
# cookie is issued for the API's host, and localhost:3000 -> localhost:8000
# is same-site (ports do not affect site matching), so the SameSite=Lax
# cookie is sent. Mixing localhost and 127.0.0.1 makes every authenticated
# request fail with 401.
NEXT_PUBLIC_API_URL=http://localhost:8000
